DAYTONA_API_KEY=
# Optional. Defaults to https://app.daytona.io/api
# DAYTONA_API_URL=
# Optional. us | eu
# DAYTONA_TARGET=

# Stage 2 — edge proxy. Without these, slug lookup uses an in-memory store.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PREVIEW_BASE_DOMAIN=
# PROXY_PORT=8080

# Stage 3 — DNSimple (use sandbox tokens while developing)
# DNSIMPLE_API_TOKEN=
# DNSIMPLE_ACCOUNT_ID=
# DNSIMPLE_API_BASE=https://api.sandbox.dnsimple.com
# EDGE_IP=
# APP_DOMAIN=
# ACME_EMAIL=
